# Copy to .env (local dev) and fill in real values. Never commit the
# resulting .env file. Production values are set on Northflank.

NODE_ENV=development
PORT=10000
APP_URL=http://localhost:10000

# Postgres connection string (Render managed Postgres or local instance)
DATABASE_URL=

# PEM CA certificate for the managed Postgres provider (e.g. Render's CA
# bundle). Optional -- without it, production TLS to Postgres is encrypted
# but unverified (see database.js). Set this to enable certificate
# verification once confirmed stable for the deployment.
DATABASE_CA_CERT=

# Signs auth JWTs. Required in production (server refuses to boot without
# it); a random value is used automatically outside production.
JWT_SECRET=

# Optional shared password for non-admin bootstrap users supplied through
# BOOTSTRAP_USERS_JSON. Leave empty unless you intentionally seed non-admin
# accounts during deployment.
SHARED_PASSWORD=

# Required in production for the first admin bootstrap account.
ADMIN_SEED_PASSWORD=
ADMIN_SEED_USER_CODE=
ADMIN_SEED_NICKNAME=BOLD

# Optional one-time recovery switch. Set to true only when the configured
# admin user already exists and its password/role must be repaired on boot;
# turn it back to false/remove it after successful login.
ADMIN_SEED_RESET=false

# Optional JSON array for non-admin bootstrap accounts. Do not commit real
# user-code inventories to the repository; set them only in deployment env.
# Example: [{"userCode":"123456","nickname":"BOLD-001"}]
BOOTSTRAP_USERS_JSON=

# Address login-approval emails are sent to (server/src/services/email.js).
# Left blank here like the other per-deployment values above; falls back to
# the organization's real address in code if unset.
CENTER_EMAIL=

# AI providers -- tried in order (Claude -> Gemini -> OpenAI) with fallback
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Transactional email (approval mails, reports)
RESEND_API_KEY=

# Optional -- Redis for multi-instance online-state/rate-limit consistency.
# Falls back to in-process memory when unset.
REDIS_URL=

# Optional -- S3-compatible object storage for uploaded files.
# Falls back to local disk when unset.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=

# Optional -- error tracking
SENTRY_DSN=
LOG_LEVEL=info

# Optional -- fine-grained PAT with read-only "Contents" access to this repo.
# Needed for /api/version/latest (Android/desktop update check) to keep
# working if the repo is private; unset falls back to an unauthenticated
# GitHub API call, which only sees releases on a public repo.
GITHUB_TOKEN=

# Optional -- real IBM Quantum hardware verification lane (never feeds back
# into scored results). Unset means simulator-only.
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_WAIT_SECONDS=60

# Optional -- web push notifications. Generate with
# `npx web-push generate-vapid-keys`. Unset means push stays disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional -- conversation memory retention window in days (default applied
# in code if unset)
CONVERSATION_MEMORY_TTL_DAYS=

# Optional -- comma-separated RSS feed URLs for the morning brief
NEWS_RSS_SOURCES=

# Optional -- override the Python interpreter used to spawn the quantum
# worker (defaults to "python3")
PYTHON_BIN=

# Optional -- BCI (BOLD Cyber Intelligence) integration. BCI is a separate,
# independently deployed service (see bci/) with its own database and
# users; BQI never talks to BCI's database directly, only its API.
# Unset means the Cyber Analysis module reports itself unavailable rather
# than failing the rest of the app (spec: BCI down must never take
# BQI down).
BCI_BASE_URL=
# Shared secret used ONLY to sign/verify the short-lived gateway token that
# lets BQI mint a BCI session for the calling user -- this is NOT
# BCI's own JWT_SECRET and must never be set to the same value. Must match
# BCI_GATEWAY_SECRET configured on the BCI side exactly.
BCI_GATEWAY_SECRET=

# Optional -- required only for Android passkey login (Settings > Security).
# Comma-separated SHA-256 certificate fingerprint(s) of the Android signing
# keystore(s), colon-delimited hex exactly as `keytool -list -v -keystore
# <path> -alias <alias>` prints the "SHA256:" line. Served at
# /.well-known/assetlinks.json so Android's Credential Manager can verify
# this app is allowed to create/use a passkey for this server's origin.
# Unset means Android passkey registration/login will not work; other login
# methods and other platforms' passkey support are unaffected.
ANDROID_PASSKEY_CERT_FINGERPRINTS=

# --- SFRE (Systemic Financial Risk & Market Integrity Engine), see docs/sfre/OPERATIONS.md ---
# Persistence uses DATABASE_URL above (tables are created automatically, append-only). Without it SFRE keeps state in memory only.
# MKK "KAP Veri Yayin Servisi" (REST). Base URL / auth header come from your MKK onboarding documents (the public PDF does not state them).
SFRE_KAP_BASE_URL=
SFRE_KAP_API_KEY=
# Defaults: header "Authorization", scheme "Bearer". For a raw key header set e.g. SFRE_KAP_AUTH_HEADER=X-API-KEY and SFRE_KAP_AUTH_SCHEME= (empty).
SFRE_KAP_AUTH_HEADER=Authorization
SFRE_KAP_AUTH_SCHEME=Bearer
SFRE_KAP_MIN_INTERVAL_MS=1000
# Optional generic JSON-feed gateways for other primary sources (schema: {items:[{url,title,snippet,publication_time,claim_key}]}):
# SFRE_OFFICIAL_SPK_FEED_URL= / SFRE_OFFICIAL_SPK_FEED_TOKEN= ; SFRE_OFFICIAL_BORSA_ISTANBUL_FEED_URL= ; SFRE_COMPANY_IR_FEED_URL= ; SFRE_NEWS_RELIABLE_FEED_URL=
# TCMB EVDS (evds2.tcmb.gov.tr): free API key from your EVDS profile. The SERVER fetches the series, so every client sees them.
# Default series: USD and EUR indicative buying rate in TRY since 2018 (comma-separated EVDS codes in SFRE_EVDS_SERIES to change).
TCMB_EVDS_KEY=
# SFRE_EVDS_SERIES=TP.DK.USD.A.YTL,TP.DK.EUR.A.YTL
# SFRE_EVDS_START=2018-01-01
# Limits
SFRE_MAX_CONCURRENT_RUNS=2
