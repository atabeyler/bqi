# BCI API — environment variables
# Copy to .env for local development. Never commit real .env files.

# Server
NODE_ENV=development
PORT=8081

# Postgres — BCI owns a dedicated database/schema, never shares BQI's.
BCI_DATABASE_URL=postgres://bci:bci@localhost:5432/bci
BCI_DATABASE_CA_CERT=

# Auth — BCI has its own JWT secret and its own users; it never trusts or
# reuses BQI's JWT_SECRET or auth_users table.
BCI_JWT_SECRET=
BCI_JWT_TTL_SECONDS=14400

# Pentest account vault: 64 hex characters (32 random bytes), same secret in
# API and worker. Keep stable and back it up securely; never commit its value.
# Account creation returns 503 when this is absent. Existing scanning works.
BCI_PENTEST_VAULT_KEY=
# Legacy deployment auth profiles now require tenant/origin bindings when
# used through the API/worker. Prefer the tenant-bound encrypted account API.
# BCI_AUTH_PROFILE_OWNER_ADMIN_API=<BCI organization UUID>
# BCI_AUTH_PROFILE_ORIGIN_ADMIN_API=https://your-test-host.example

# First-boot bootstrap: creates one organization and one system_admin user
# if (and only if) no organization exists yet. Leave unset after first boot;
# has no effect once an organization exists.
BCI_BOOTSTRAP_ORG_NAME=
BCI_BOOTSTRAP_ADMIN_EMAIL=
BCI_BOOTSTRAP_ADMIN_PASSWORD=

# CORS — comma-separated allowlist of origins permitted to call the BCI API
# directly (e.g. the future standalone BCI UI). The BQI server calls
# BCI server-to-server and is not subject to this browser CORS check.
BCI_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=info

# Gateway integration (M14) -- lets a trusted external system (BQI)
# mint a BCI session for one of its own authenticated users. Must be set to
# the SAME value as BQI's own BCI_GATEWAY_SECRET, and must NEVER be
# the same value as BCI_JWT_SECRET above. Unset means every gateway session
# request is rejected (fail closed), not silently accepted.
BCI_GATEWAY_SECRET=
BCI_GATEWAY_ORG_SLUG=bqi
BCI_GATEWAY_SESSION_TTL_SECONDS=900

# AI Decision Support (M13) -- AI_DISABLED is the safe default; BCI's own
# security analysis never depends on this being configured.
BCI_AI_MODE=AI_DISABLED
BCI_ANTHROPIC_API_KEY=

# Engine adapters (M5) -- override only if a binary isn't on PATH under its
# default name. An engine whose binary can't be found reports OFFLINE via
# healthCheck() rather than crashing anything that calls it.
BCI_TRIVY_BIN=trivy
BCI_OSV_SCANNER_BIN=osv-scanner
BCI_SEMGREP_BIN=semgrep
BCI_NUCLEI_BIN=nuclei
BCI_NAABU_BIN=naabu
BCI_ENGINE_HEALTH_MODE=LOCAL
BCI_ENGINE_HEALTH_STALE_MS=900000

# Controlled Proof public visibility (optional, fail-closed). No code or hook
# is installed on the customer origin. The token must be limited to Workers
# Scripts + Workers Routes for only the listed zones. Never put the token in
# BCI_CONTROLLED_PROOF_CLOUDFLARE_TARGETS or the database.
BCI_CONTROLLED_PROOF_CLOUDFLARE_API_TOKEN=
# Provider-neutral target catalog. Only adapters implemented in the registry
# are selectable; an unknown or unconfigured provider fails closed.
BCI_CONTROLLED_PROOF_PUBLIC_PROVIDER_ORDER=cloudflare-edge-worker
BCI_CONTROLLED_PROOF_PUBLIC_TARGETS={"www.example.com":{"provider":"cloudflare-edge-worker","accountId":"...","zoneId":"..."}}
# Backward-compatible legacy Cloudflare-only mapping (prefer PUBLIC_TARGETS).
BCI_CONTROLLED_PROOF_CLOUDFLARE_TARGETS={}

# Quantum Compute Gateway (spec section 5-6) -- all optional. Unset means
# the ibm_quantum provider reports NOT_CONFIGURED and every other provider
# (classical, quantum-inspired, local simulator) keeps working. Never
# persisted to the database, never logged.
BCI_IBM_QUANTUM_TOKEN=
BCI_IBM_QUANTUM_INSTANCE=
# Python interpreter used to run the quantum_simulator (qiskit-aer) and
# ibm_quantum scripts under bci/quantum/ -- see bci/quantum/requirements.txt.
BCI_PYTHON_BIN=python3

# Authenticated pentest credentials: provision secrets outside the repository.
BCI_PENTEST_VAULT_KEY=
# Keep historical keys until accounts have been rotated via POST /pentest/accounts/rotate.
BCI_PENTEST_VAULT_KEYRING=
# Optional HTTPS HashiCorp Vault Transit deployment. Context binds ciphertext to org_id.
BCI_PENTEST_VAULT_URL=
BCI_PENTEST_VAULT_TOKEN=
BCI_PENTEST_VAULT_TRANSIT_KEY=bci-pentest
# Ed25519 PEM keys. Without a signing key, reports explicitly show UNSIGNED.
BCI_PENTEST_EVIDENCE_PRIVATE_KEY=
BCI_PENTEST_EVIDENCE_PUBLIC_KEY=
# Historical trusted keys: JSON keyed by SHA256 of SPKI DER, values public PEM.
BCI_PENTEST_EVIDENCE_PUBLIC_KEYS=
# Explicit loopback lab origins for standalone native HTTP engines, empty in production.
BCI_NATIVE_LAB_ORIGINS=

# Operator-bound pentest environment and worker identity.
BCI_STAGING_ORIGINS=
BCI_WORKER_ORG_ID=
# AWS default credential chain / IRSA: never commit access keys.
AWS_REGION=
BCI_PENTEST_KMS_KEY_ID=
BCI_KMS_CUSTOM_KEY_STORE_ID=
BCI_PREFLIGHT_TENANT_ID=
BCI_PREFLIGHT_CLOUD_CANARY_APPROVED=
# Operator provisioning only; leave unset in application runtime.
BCI_CLOUD_PROVISIONING_APPROVED=
# COMPLIANCE retention is irreversible until expiry.
BCI_EVIDENCE_WORM_BUCKET=
BCI_EVIDENCE_CHECKPOINT_BUCKET=
BCI_EVIDENCE_S3_KMS_KEY_ID=
BCI_EVIDENCE_COMPLIANCE_APPROVED=
BCI_EVIDENCE_RETENTION_DAYS=365
BCI_EVIDENCE_MAX_RETENTION_DAYS=2555
BCI_EVIDENCE_TSA_URL=
BCI_EVIDENCE_TSA_CA_FILE=
# Deployment preflight runs from a prepared operator environment with kubectl.
BCI_KUBE_CONTEXT=
BCI_KUBE_NAMESPACE=
BCI_KUBE_WORKER_POD=
BCI_KUBE_CONTROL_POD=
BCI_NETWORK_ALLOWED_CANARIES=
BCI_NETWORK_DENIED_CANARIES=
# Match PostgreSQL tools to the deployed server major.
BCI_PG_DUMP_BIN=pg_dump
BCI_PG_RESTORE_BIN=pg_restore
