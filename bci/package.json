{
  "name": "bci-api",
  "version": "0.1.101",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "tsx src/index.js",
    "dev": "tsx watch src/index.js",
    "worker": "tsx src/worker.js",
    "worker:dev": "tsx watch src/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src \"test/*.test.js\" \"test/helpers/*.js\" test/globalSetup.js eslint.config.js vitest.config.js vitest.pure.config.js",
    "lint:fix": "eslint . --fix",
    "migrate": "tsx src/db/migrate.js",
    "bundle:generate-keys": "tsx scripts/generate-bundle-keys.js",
    "bundle:export": "tsx scripts/bundle-export.js",
    "bundle:import": "tsx scripts/bundle-import.js",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "test": "vitest run",
    "test:pure": "vitest run --config vitest.pure.config.js",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "tsx": "^4.23.1",
    "uuid": "^10.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.7.0",
    "supertest": "^7.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
