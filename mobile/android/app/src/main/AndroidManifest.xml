<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the in-app update flow (mobileUpdate.approve, see mobileBridge.js)
         hand a downloaded APK straight to the system package installer via a
         FileProvider content:// intent, instead of routing the download
         through Chrome (which flags sideloaded .apk downloads with its own
         "may be harmful" Safe Browsing warning on top of Android's own
         unknown-sources install prompt). Required on Android 8+ for any app
         that triggers ACTION_INSTALL_PACKAGE / opens an APK with an install
         intent. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Backs the @capacitor/geolocation plugin used by the dashboard's
         personnel-radar location sharing (see DashboardPage.jsx). Requesting
         location through this plugin instead of the WebView's own
         navigator.geolocation triggers Android's native OS permission
         dialog, which shows this app's own name and icon, instead of
         the WebView's per-origin geolocation prompt, which would otherwise
         show the site's raw hosting URL. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
